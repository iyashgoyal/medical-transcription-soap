# Reference environment file. Export these variables in your shell before
# running the pipeline. A local .env is git-ignored if you keep one, but the
# code reads the process environment (it does not auto-load .env).

# Required for SOAP generation and for the Gemini transcription fallback.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# GEMINI_TEMPERATURE=0.2
# WHISPER_MODEL_SIZE=small
# WHISPER_DEVICE=auto
# WHISPER_BEAM_SIZE=5
# SOAP_OUTPUT_DIR=output
